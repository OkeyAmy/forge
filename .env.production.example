FORGE_DOMAIN=forge.example.com
RUST_LOG=forge_api=info,tower_http=info
FORGE_ENABLE_LEGACY_RUN_API=false
FORGE_ENABLE_LEGACY_ISSUES_API=false
FORGE_JOB_STORE_PATH=/data/forge/jobs.json
FORGE_PUBLIC_CHECKS=cargo test --workspace
FORGE_E2B_RUNNER=scripts/e2b-runner/run-job.mjs
# Optional override command run inside the cloned target repository after /forge approve.
# If empty, Forge uses FORGE_MODEL/FORGE_BASE_URL/FORGE_API_KEY for a model-guided E2B edit loop.
# Custom commands receive FORGE_ISSUE_FILE and FORGE_ISSUE_NUMBER.
FORGE_E2B_WORK_COMMAND=
FORGE_E2B_MAX_STEPS=6

E2B_API_KEY=e2b_xxx

GITHUB_WEBHOOK_SECRET=replace-with-long-random-secret
GITHUB_APP_ID=3711549
GITHUB_APP_PUBLIC_URL=https://github.com/apps/meizenai/installations/new
GITHUB_API_BASE_URL=https://api.github.com
# Prefer mounting this file in production instead of putting the PEM in .env.
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app-private-key.pem

FORGE_MODEL=gpt-4o-mini
FORGE_BASE_URL=https://api.openai.com/v1
FORGE_API_KEY=sk-xxx
